# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Optional database URL. Empty keeps everything in memory. postgres:// URLs are converted for asyncpg.
# Local example: sqlite+aiosqlite:///./threatwatcher.db   Render: the Postgres URL.
DATABASE_URL=

# Required. Random string of at least 32 bytes that signs session tokens; startup fails without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional Groq API key for AI IP summaries. Empty turns the summaries off.
GROQ_API_KEY=

# Optional Groq model name. Empty uses openai/gpt-oss-20b.
GROQ_MODEL=

# Optional AbuseIPDB key for the threat IP feed and IP reputation. Empty uses the cached or sample feed.
ABUSEIPDB_API_KEY=

# Optional ipinfo token for IP geolocation. Empty uses built-in fallback data.
IPINFO_TOKEN=

# Only the exact value "development" allows the session cookie over plain HTTP (local dev only).
ENV=

# Demo mode is ON unless this is "false", in any case (fails closed). Demo mode rejects writes.
DEMO_MODE=

# Admin password outside demo mode, 12-72 bytes. Required when no admin exists yet (always without a database).
# Ignored in demo mode.
ADMIN_PASSWORD=

# Optional path to the threat IP cache file. Empty uses backend/threat_ips_cache.json (e2e checks use a fixed one).
THREAT_IPS_CACHE=

# Swagger UI, ReDoc and the OpenAPI schema are off unless this is "true", in any case (local development only).
ENABLE_API_DOCS=

# Number of trusted proxies in front of the app for HTTP requests. Empty means 1; 0 ignores X-Forwarded-For.
# A value higher than the real number lets a client forge its rate-limit key. May differ from the WebSocket value.
TRUSTED_PROXY_HOPS_HTTP=

# Number of trusted proxies in front of the app for WebSocket upgrades. Empty means 1; 0 ignores X-Forwarded-For.
# A value higher than the real number lets a client forge its rate-limit key. May differ from the HTTP value.
TRUSTED_PROXY_HOPS_WS=
