# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Optional database. Empty = everything in memory.
# Local example: sqlite+aiosqlite:///./threatwatcher.db   Render: the Postgres URL.
DATABASE_URL=

# Required. Random string of at least 32 bytes used to sign session tokens;
# startup fails without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional AI summaries (Groq). GROQ_MODEL overrides the default model.
GROQ_API_KEY=
GROQ_MODEL=

# Optional threat intel enrichment.
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# "development" allows the session cookie over plain HTTP (local dev only).
ENV=

# Demo mode is ON unless this is exactly "false" (fails closed).
# In demo mode writes are rejected and the public demo accounts exist.
DEMO_MODE=

# Required when DEMO_MODE=false: the admin password, 12-72 bytes.
# Ignored in demo mode (the admin uses the public demo password).
ADMIN_PASSWORD=

# Number of reverse proxies that append to X-Forwarded-For (default 1; 0 = use
# the socket address). Verify on the host before relying on login rate limits.
TRUSTED_PROXY_HOPS=

# Optional: read the threat IP list from this file instead of
# backend/threat_ips_cache.json (the e2e checks use a fixed one).
THREAT_IPS_CACHE=
